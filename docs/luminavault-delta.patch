+
+    def test_requests_style_response_attribute(self):
+        from tools.tool_backend_helpers import classify_audio_exception
+
+        class Err(Exception):
+            response = MagicMock(status_code=402)
+
+        assert classify_audio_exception(Err()) == "quota"
+
+    def test_gemini_embeds_the_status_in_the_message_only(self):
+        """Gemini's TTS path raises a bare RuntimeError; the text is all there is."""
+        from tools.tool_backend_helpers import classify_audio_exception
+
+        exc = RuntimeError("Gemini TTS API error (HTTP 429): RESOURCE_EXHAUSTED")
+        assert classify_audio_exception(exc) == "rate_limit"
+
+    def test_unrecognised_failures_are_treated_as_transient(self):
+        from tools.tool_backend_helpers import classify_audio_exception
+
+        assert classify_audio_exception(RuntimeError("socket closed")) == "upstream"
+
+    def test_stt_taxonomy_is_the_same_taxonomy(self):
+        """One set, so the gateway's user-facing check means the same thing."""
+        from tools.tool_backend_helpers import AUDIO_USER_FACING_ERROR_KINDS
+        from tools.transcription_tools import STT_USER_FACING_ERROR_KINDS
+
+        assert STT_USER_FACING_ERROR_KINDS is AUDIO_USER_FACING_ERROR_KINDS
diff --git a/tests/hermes_cli/test_default_fallback_chain.py b/tests/hermes_cli/test_default_fallback_chain.py
new file mode 100644
index 0000000000..4a5979e5d9
--- /dev/null
+++ b/tests/hermes_cli/test_default_fallback_chain.py
@@ -0,0 +1,32 @@
+"""The shipped default fallback chain.
+
+LuminaVault provisions one Hermes per tenant, each with a fresh PVC seeded from
+``DEFAULT_CONFIG``. An empty ``fallback_providers`` meant a tenant whose primary
+provider lost auth had nowhere to go and the turn simply failed. The default now
+carries a zero-cost OpenRouter chain so a fresh tenant always has somewhere to
+land.
+"""
+
+from hermes_cli.config import DEFAULT_CONFIG
+from hermes_cli.fallback_config import get_fallback_chain
+
+
+def test_default_config_ships_a_non_empty_fallback_chain():
+    assert DEFAULT_CONFIG["fallback_providers"], "a fresh tenant must inherit a fallback chain"
+
+
+def test_default_chain_parses_into_ordered_provider_model_entries():
+    chain = get_fallback_chain(DEFAULT_CONFIG)
+    assert [(e["provider"], e["model"]) for e in chain] == [
+        ("openrouter", "z-ai/glm-5.2:free"),
+        ("openrouter", "nvidia/nemotron-3-ultra-550b-a55b:free"),
+        ("openrouter", "deepseek/deepseek-v4-flash"),
