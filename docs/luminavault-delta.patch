+    @pytest.mark.asyncio
+    async def test_ingestion_runs_agent_and_returns_structured_analysis(self, adapter):
+        analysis = {
+            "title": "Quarterly report",
+            "markdown": "## Revenue\nUp year over year.",
+            "summary": "Revenue increased.",
+            "tags": ["finance"],
+            "credibility": {
+                "score": 90,
+                "confidence": 0.9,
+                "signals": ["primary document"],
+                "rationale": "Direct filing.",
+                "version": "v1",
+            },
+        }
+        adapter._run_agent = AsyncMock(return_value=({"final_response": json.dumps(analysis)}, {"total_tokens": 12}))
+        app = _create_app(adapter)
+        async with TestClient(TestServer(app)) as cli:
+            resp = await cli.post(
+                "/v1/ingestions",
+                json={"source_url": "https://vault.example/source-token", "content_type": "application/pdf"},
+            )
+            assert resp.status == 200
+            data = await resp.json()
+            assert data["object"] == "hermes.ingestion.result"
+            assert data["analysis"] == analysis
+            prompt = adapter._run_agent.await_args.kwargs["user_message"]
+            assert "https://vault.example/source-token" in prompt
+            assert "untrusted content" in prompt
